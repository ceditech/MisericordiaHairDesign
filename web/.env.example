# Copy to .env.local for local development. NEVER commit real values.
# Every value below is a placeholder. Legend: [public] is sent to the browser, [secret] stays on the server.
# Production values live in apphosting.yaml (public values) and Google Secret Manager (secrets).

# --- Firebase client (all [public]; from Firebase console > Project settings > Your apps) -----------------
# Set to "true" to use the local emulators (npm run firebase:emulators): auth 9099, firestore 8080, storage 9199.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY="PLACEHOLDER_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="PLACEHOLDER_MESSAGING_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="PLACEHOLDER_APP_ID"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="PLACEHOLDER_MEASUREMENT_ID"

# --- Firebase Admin SDK [secret] ----------------------------------------------------------------------------
# Provide ONE of the following (checked in this order). Never commit a service-account file.
# 1) Minified service-account JSON on one line (see scripts/gen-env-key.js):
FIREBASE_SERVICE_ACCOUNT_KEY='PLACEHOLDER_SERVICE_ACCOUNT_KEY_JSON_STRING'
# 2) The same JSON, base64-encoded:
# FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=
# 3) Path to a service-account file (Application Default Credentials):
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Public site URL [public, optional] ---------------------------------------------------------------------
# Base URL for links in emails and payment return URLs. Falls back to a hardcoded domain if unset; set it
# per environment (http://localhost:3000 locally).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Payments: Stripe [secret unless noted] -----------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=PLACEHOLDER_STRIPE_PUBLISHABLE_KEY   # [public]
STRIPE_SECRET_KEY=PLACEHOLDER_STRIPE_SECRET_KEY
# Signing secret of the webhook endpoint /api/stripe/webhook (for local testing: `stripe listen`).
STRIPE_WEBHOOK_SECRET=PLACEHOLDER_STRIPE_WEBHOOK_SECRET

# --- Payments: PayPal [secret] ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=PLACEHOLDER_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=PLACEHOLDER_PAYPAL_CLIENT_SECRET
# "sandbox" (default) or "live".
PAYPAL_MODE=sandbox

# --- Gmail sender OAuth (owner dashboard > Email settings) [secret] -----------------------------------------
GOOGLE_CLIENT_ID="PLACEHOLDER_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="PLACEHOLDER_GOOGLE_CLIENT_SECRET"
# Must match an authorized redirect URI of the OAuth client.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/admin/email/callback"

# --- Access control and notifications [secret / optional] ---------------------------------------------------
# Comma-separated emails treated as super admin by the API routes. If unset, the defaults in
# src/lib/config/adminEmails.ts apply. Setting it REPLACES the defaults. The account's email must be verified.
# SUPER_ADMIN_EMAILS=owner@example.com
# Shared secret a scheduler sends as "Authorization: Bearer <value>" to POST /api/admin/reminders.
# If unset, only a super admin can trigger reminders (fails closed).
# CRON_SECRET=
# Where new-booking, new-order and contact-form notification emails go. Defaults to the address in
# src/lib/config/adminEmails.ts if unset.
# OWNER_NOTIFICATION_EMAIL=owner@example.com

# --- Owner dashboard UI [public] ----------------------------------------------------------------------------
NEXT_PUBLIC_OWNER_DASH_UI=stitch
